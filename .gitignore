# ==========================================
# Unity Standard .gitignore
# ==========================================

# Unity generated directories & cache (RẤT NẶNG - KHÔNG ĐƯA LÊN GIT)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta files must NEVER be ignored
!/[Aa]ssets/**/*.meta

# Autogenerated IDE / Solution files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.slnx

# Unity autogenerated build & crash files
sysinfo.txt
*.stackdump

# Crashlytics & diagnostic reports
crashlytics-build.properties

# Visual Studio / VS Code / Rider cache & settings
.vs/
.idea/
.vscode/
*.private
*.private.meta

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Builds
*.apk
*.aab
*.unitypackage
*.app
